{
  "apps": [
    {
      "name": "ts-orbit-local",
      "script": "./scripts/start.mjs",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000,
        "HOST": "127.0.0.1"
      },
      "env_production": {
        "NODE_ENV": "production"
      },
      "watch": false,
      "max_memory_restart": "500M",
      "error_file": "./logs/pm2-err.log",
      "out_file": "./logs/pm2-out.log",
      "merge_logs": true,
      "time": true
    }
  ]
}
