# Local application settings. Relative paths resolve from the project root.
HOST=127.0.0.1
PORT=3000
# Leave blank to derive the origin from HOST and PORT. Behind a TLS reverse proxy on a
# domain, set the public HTTPS origin (e.g. https://app.example.com) together with
# ALLOW_NETWORK_ACCESS=true; non-loopback origins must be HTTPS.
APP_ORIGIN=
# Reverse proxies trusted for X-Forwarded-For / X-Forwarded-Proto, so rate limits and
# session records see the real client address. Empty = no proxy. Use "loopback" for a
# proxy on the same machine, a hop count (1-10), or addresses/subnets such as 10.0.0.0/8.
# "true" is rejected: it would let any client choose its own address.
TRUST_PROXY=
DATA_DIR=./data
# Optional one-time import of a legacy JSON database; the original is preserved.
LEGACY_DB_IMPORT=
# A random persistent signing secret is stored in DATA_DIR automatically.
# Optional explicit network binding; leave false for local execution.
ALLOW_NETWORK_ACCESS=false
# Maximum bytes per uploaded file (default 25 MiB, at most 1 GiB).
FILE_MAX_BYTES=26214400

