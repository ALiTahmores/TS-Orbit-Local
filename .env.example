# Local application settings. Relative paths resolve from the project root.
HOST=127.0.0.1
PORT=3000
# Leave blank to derive the origin from HOST and PORT.
APP_ORIGIN=
DATA_DIR=./data
# Optional one-time import of a legacy JSON database; the original is preserved.
LEGACY_DB_IMPORT=
# A random persistent signing secret is stored in DATA_DIR automatically.
# Optional explicit network binding; leave false for local execution.
ALLOW_NETWORK_ACCESS=false
# Maximum bytes per uploaded file (default 25 MiB, at most 1 GiB).
FILE_MAX_BYTES=26214400

